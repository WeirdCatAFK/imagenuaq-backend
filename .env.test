# Overrides layered on top of .env when running `npm test`. Both files are loaded, in that
# order, and the later one wins -- see the `test` script in package.json.
#
# There is deliberately NO DATABASE_URL here. tests/helpers/env.js derives the test
# database from the one in .env by swapping the database name for `imagenuaq_test`, and
# refuses to run if the result does not end in `_test`. Putting a URL here would mean
# either committing the local Postgres password or keeping a second copy of it in sync,
# and it would remove the one check that makes it structurally impossible for a TRUNCATE
# in the fixtures to reach the development database.
#
# That is also why this file is committed while .env is not: nothing in it is a secret.

# Not `production`. The error handler withholds messages and omits `stack` when it is, and
# the suite asserts those messages verbatim -- they are part of the contract the frontend
# reads.
NODE_ENV=test

# A throwaway key. It only has to clear the 32-character floor that orchestration/auth.js
# enforces before it will sign anything; it never protects a real session.
JWT_SECRET=test-only-key-do-not-use-anywhere-else-0123456789

# Pinned into every token as `iss`/`aud` and re-checked on verification. Fixed here rather
# than inherited so the suite can mint a token with a different issuer and prove it is
# rejected -- the cross-deployment guard in verifyToken().
API_DOMAIN=http://localhost:3000
FRONTEND_DOMAIN=http://localhost:5173
