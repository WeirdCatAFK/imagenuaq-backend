{
  "name": "imagenuaq-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Express backend (ESM) — postgrejs + node-pg-migrate",
  "type": "module",
  "main": "main.js",
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env main.js",
    "dev": "node --watch --env-file-if-exists=.env main.js",
    "migrate": "node --env-file-if-exists=.env node_modules/node-pg-migrate/bin/node-pg-migrate.js",
    "migrate:new": "npm run migrate -- create -j sql",
    "migrate:up": "npm run migrate -- up",
    "migrate:down": "npm run migrate -- down",
    "migrate:redo": "npm run migrate -- redo",
    "migrate:status": "npm run migrate -- up --dry-run"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "morgan": "^1.10.1",
    "postgrejs": "^2.23.1"
  },
  "devDependencies": {
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.0"
  }
}
