{
  "name": "imagenuaq-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Express backend (ESM) template — postgrejs + Prisma Migrate",
  "type": "module",
  "main": "main.js",
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env main.js",
    "dev": "node --watch --env-file-if-exists=.env main.js",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "morgan": "^1.10.1",
    "postgrejs": "^2.23.1"
  },
  "devDependencies": {
    "prisma": "^7.10.0"
  }
}
