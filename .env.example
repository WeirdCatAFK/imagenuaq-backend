# Copy to .env and fill in every value. compose.yaml has no fallbacks: an unset or empty
# variable makes Compose refuse to start and name it, rather than guess a default.
NODE_ENV=development
HOST=localhost
PORT=3000
LOG_FORMAT=dev
CORS_ORIGIN=*
# HS256 signing key for session tokens. At least 32 characters -- src/access/orchestration/
# auth.js refuses to sign or verify below that, because a key shorter than the hash it
# feeds is the one HMAC weakness that is trivially avoidable. Generate one, do not invent
# it by hand: `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`.
#
# Changing it invalidates every token in circulation, which is the intended lever if one
# leaks: there is no blocklist, so rotating this secret is how a session is revoked before
# its seven days are up.
JWT_SECRET=replaceme-at-least-32-characters-long

# Pinned into every token as `iss` and `aud`, and re-checked on every verification. They
# are not cosmetic: they stop a token minted by another deployment -- staging, a developer's
# laptop -- from being accepted here, even if that deployment shares this secret. Both must
# match the values the frontend was built against, so changing either logs everyone out.
API_DOMAIN=http://localhost:3000
FRONTEND_DOMAIN=http://localhost:5173

# Microsoft 365 -- the delegated sign-in that reads the areas' Excel trackers (RF-MIG-01,
# src/access/orchestration/microsoft.js). Register an application once in Azure (Entra ID
# > App registrations): account type "any organizational directory and personal accounts"
# for a `common` tenant, or the UAQ tenant alone with its tenant id; redirect URI of type
# Web set to exactly `${API_DOMAIN}/api/microsoft/callback`; a client secret; and the
# delegated Graph permissions `offline_access`, `User.Read`, `Files.Read.All`. Staff then
# consent for their own account from the frontend -- no token is ever pasted here.
#
# The three values below are the FALLBACK. The normal place for them is the
# `microsoft_app` row an admin saves from the frontend's settings screen, which wins over
# these whenever it exists and needs no restart. Leave them empty to rely on that row;
# the sign-in answers 503 until one or the other is set. The test suite uses these.
#
# Nothing in compose.yaml needs to change for these: the server service loads this whole
# file through env_file, and only the values Compose itself interpolates carry a `:?`.
MS_TENANT_ID=common
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Encrypts the refresh tokens at rest (src/utils/crypto.js). Exactly 32 random bytes,
# base64: `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`.
# Changing it makes every stored token unreadable, so every account must be reconnected.
MS_TOKEN_KEY=replaceme-32-bytes-base64

# The area new areas hang under when POST /api/areas names no parent, and the area
# `npm run admin:create` puts an admin in when --area is not given. Matched by name,
# case-insensitively but accent included -- findArea() in src/access/resources/query.js.
# Unset, empty, or naming no area: there is no default, the admin gets no area and a new
# area is a root of the chart. Nothing warns, so keep it in step with a rename.
DEFAULT_AREA=Coordinación
# Read by postgrejs at runtime and by node-pg-migrate when applying migrations.
# 127.0.0.1, not localhost: localhost resolves to ::1 first, and postgrejs over IPv6 loopback
# to the Docker port pays ~260 ms per query instead of ~1 ms.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/imagenuaq

# Read by compose.yaml only, to create the `db` container. DATABASE_URL above must stay
# in sync with these: it is what the app and node-pg-migrate actually connect with.
# POSTGRES_PORT is the host port the database is published on; inside the Compose
# network the server always reaches it as db:5432.
# PGADMIN_PORT is separate on purpose: pgadmin and the database cannot share a
# host port. pgadmin listens on 80 inside its container.

# Largest single upload accepted, in bytes. 512 MiB. The stream is aborted past this while
# it is still under tmp/ in the bucket, so an oversize upload never reaches content/.
MAX_UPLOAD_BYTES=536870912

POSTGRES_VERSION=18
POSTGRES_DB=imagenuaq
POSTGRES_USER=replaceme
POSTGRES_PASSWORD=replaceme
POSTGRES_PORT=5432

PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=replaceme

# File content lives in MinIO, keyed by SHA-256; names, folders and permissions live in
# Postgres (src/access/primitives/storage.js). The server refuses to start if the bucket is
# missing, and compose.yaml's minio-init creates it. MINIO_ENDPOINT is the host view;
# compose.yaml overrides it inside the server container. The API uses the root
# credentials for now.
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=admin_empresa
MINIO_ROOT_PASSWORD=TuPasswordSuperSeguro123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_DOCUMENTS_BUCKET=documentos

# Read by compose.yaml only: the HOST paths of MinIO's four disks, bind-mounted into the
# container at /data1../data4. These defaults are the local development ones and match the
# paths .gitignore already excludes; a server points them at its real mounts instead.
MINIO_DISK1=./tests/minio/disk1
MINIO_DISK2=./tests/minio/disk2
MINIO_DISK3=./tests/minio/disk3
MINIO_DISK4=./tests/minio/disk4

# Read by compose.yaml only: the HOST path of the AIStor licence, mounted read-only into the
# minio container. The file is a credential and /minio.license is git-ignored; copy it into
# the backend root, or point this at wherever the server keeps it.
MINIO_LICENSE=./minio.license
