# Copy to .env and fill in every value. compose.yaml has no fallbacks: an unset or empty
# variable makes Compose refuse to start and name it, rather than guess a default.
NODE_ENV=development
HOST=localhost
PORT=3000
LOG_FORMAT=dev
CORS_ORIGIN=*

# HS256 signing key for session tokens. At least 32 characters -- src/access/orchestration/
# auth.js refuses to sign or verify below that, because a key shorter than the hash it
# feeds is the one HMAC weakness that is trivially avoidable. Generate one, do not invent
# it by hand: `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`.
#
# Changing it invalidates every token in circulation, which is the intended lever if one
# leaks: there is no blocklist, so rotating this secret is how a session is revoked before
# its seven days are up.
JWT_SECRET=replaceme-at-least-32-characters-long

# Pinned into every token as `iss` and `aud`, and re-checked on every verification. They
# are not cosmetic: they stop a token minted by another deployment -- staging, a developer's
# laptop -- from being accepted here, even if that deployment shares this secret. Both must
# match the values the frontend was built against, so changing either logs everyone out.
API_DOMAIN=http://localhost:3000
FRONTEND_DOMAIN=http://localhost:5173
# Read by postgrejs at runtime and by node-pg-migrate when applying migrations.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/imagenuaq

# Read by compose.yaml only, to create the `db` container. DATABASE_URL above must stay
# in sync with these: it is what the app and node-pg-migrate actually connect with.
# POSTGRES_PORT is the host port the database is published on; inside the Compose
# network the server always reaches it as db:5432.
# PGADMIN_PORT is separate on purpose: pgadmin and the database cannot share a
# host port. pgadmin listens on 80 inside its container.
# Where file content is stored. `label:path` pairs, comma separated, and the label is
# what `storage_volumes.label` holds — the path is NOT in the database, because the same
# disk mounts at a different path inside the container than on the host. Split happens on
# the FIRST colon, so a Windows path like `main:C:\storage` is read correctly.
#
# Adding a disk is one more pair here plus one row in storage_volumes. Nothing is moved
# and no path changes: placement is recorded, never derived from the hash.
#
# Each path must already hold a `.imagenuaq-volume` marker naming that label, or the
# service refuses to start. That is deliberate — an unmounted disk leaves an empty
# directory behind, and without the marker the service would write into it while
# recording that content as living on a disk that is not there. Initialise a genuinely new
# disk once with initVolume() from src/access/primitives/storage.js.
STORAGE_VOLUMES=main:/mnt/disk1,cold:/mnt/disk2

# Largest single upload accepted, in bytes. 512 MiB. The stream is aborted past this
# while it is still in tmp/, so an oversize upload never reaches content/.
MAX_UPLOAD_BYTES=536870912

POSTGRES_VERSION=18
POSTGRES_DB=imagenuaq
POSTGRES_USER=replaceme
POSTGRES_PASSWORD=replaceme
POSTGRES_PORT=5432

# Read by compose.yaml only: the HOST paths of the two disks, bind-mounted into the
# server container at /srv/storage/<label>. They duplicate the paths in STORAGE_VOLUMES
# above on purpose — that variable describes the paths as the app sees them, and inside
# the container they are different. compose.yaml overrides STORAGE_VOLUMES to match.
# The labels are the part that must stay identical on both sides.
STORAGE_MAIN_PATH=/mnt/disk1
STORAGE_COLD_PATH=/mnt/disk2

PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=replaceme
